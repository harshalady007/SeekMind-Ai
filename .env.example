# ── App ─────────────────────────────────────────────────────────────────────
# Public URL of the deployed app (used for share links and auth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL + anon key from the Supabase dashboard (Settings → API).
# Leave all three empty to run without persistence (in-memory store; pairs
# naturally with DEMO_MODE=true).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI / answer generation ──────────────────────────────────────────────────
# Server-only Anthropic API key. Required unless DEMO_MODE=true.
ANTHROPIC_API_KEY=
# Model used for answers (and query planning).
ANTHROPIC_MODEL=claude-sonnet-5

# ── Web search ──────────────────────────────────────────────────────────────
# Server-only Tavily API key. Required unless DEMO_MODE=true.
TAVILY_API_KEY=
# Active search provider: "tavily" | "mock". ("brave" is reserved for a
# future BraveSearchProvider behind the same interface.)
SEARCH_PROVIDER=tavily

# ── Demo mode ───────────────────────────────────────────────────────────────
# true = deterministic local fixtures, simulated streaming, no external APIs.
DEMO_MODE=false

# ── Usage limits ────────────────────────────────────────────────────────────
# Lifetime search allowance per anonymous session.
ANONYMOUS_SEARCH_LIMIT=5
# Searches per signed-in user per UTC day.
DAILY_USER_SEARCH_LIMIT=50
# Concurrent in-flight searches per user/session.
MAX_CONCURRENT_SEARCHES=2
# Searches allowed per client IP per minute (coarse abuse control).
SEARCHES_PER_MINUTE_PER_IP=10
# Timeout for a single external search call (ms).
SEARCH_TIMEOUT_MS=15000

# ── Research mode guardrails ────────────────────────────────────────────────
RESEARCH_MAX_ITERATIONS=3
RESEARCH_MAX_QUERIES=8
